PORT="8080"
DATABASE_URL="${{Postgres.DATABASE_URL}}"
DJANGO_SECRET_KEY="${{secret(64)}}"
SITE_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}"
CSRF_TRUSTED_ORIGINS="https://${{RAILWAY_PUBLIC_DOMAIN}}"
DJANGO_ALLOWED_HOSTS="${{RAILWAY_PUBLIC_DOMAIN}},localhost,127.0.0.1,healthcheck.railway.app"
SECURE_SSL_REDIRECT="false"
SECURE_COOKIES="true"
NUM_PROXIES="1"
CACHE_URL="dbcache://doory_cache"
MEDIA_ROOT="/app/media"
EXPORT_STORAGE_ROOT="/app/exports"
EXPORT_RENDER_PAGE_URL="http://127.0.0.1:8080/render.html"
WEB_CONCURRENCY="2"
DOORY_ADMIN_EMAIL="admin@example.com"
DOORY_ADMIN_PASSWORD="${{secret(20)}}"
DOORY_SYNC_FONTS="true"
DOORY_SYNC_ELEMENTS="false"
DOORY_SYNC_AUDIO="true"
DOORY_SEED_TEMPLATES="true"
EMAIL_URL="consolemail://"
LOG_LEVEL="INFO"
